<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="script.strem4kodi" name="Strem4Kodi" version="1.8.12" provider-name="daanvb">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="script.module.qrcode" version="6.1.0+matrix.3" optional="true" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.subtitle.module" library="subtitle_service.py" />
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Stremio experience on Kodi</summary>
    <description lang="en_GB">Strem4Kodi brings your Stremio library to Kodi with cinematic browsing, configurable automatic playback, clear source selection, shared progress and IntroDB skip controls. Kodi handles video playback.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <website>https://daanvb.github.io/strem4kodi-repository/</website>
    <source>https://github.com/daanvb/strem4kodi-repository</source>
    <news>1.8.12: refreshed Kodi app and repository artwork paths; clearer episode titles; correct search focus highlighting; full Clear recent searches label. BetterPosters unchanged.</news>
    <assets>
      <icon>resources/branding/strem4kodi-icon-v2.png</icon>
      <fanart>resources/branding/strem4kodi-fanart-v2.png</fanart>
      <screenshot>resources/previews/home.jpg</screenshot>
      <screenshot>resources/previews/episodes.jpg</screenshot>
      <screenshot>resources/previews/streams.jpg</screenshot>
      <screenshot>resources/previews/addons.jpg</screenshot>
    </assets>
  </extension>
</addon><addon id="repository.strem4kodi" name="Strem4Kodi Repository" version="1.0.4" provider-name="daanvb">
  <extension point="xbmc.addon.repository" name="Strem4Kodi Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/daanvb/strem4kodi-repository/main/addons.xml</info>
      <checksum verify="sha256">https://raw.githubusercontent.com/daanvb/strem4kodi-repository/main/addons.xml.sha256</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/daanvb/strem4kodi-repository/main/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install and update Strem4Kodi</summary>
    <description lang="en_GB">Independent Strem4Kodi addon repository maintained by daanvb.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <website>https://daanvb.github.io/strem4kodi-repository/</website>
    <source>https://github.com/daanvb/strem4kodi-repository</source>
    <assets>
      <icon>resources/branding/strem4kodi-icon-v2.png</icon>
      <fanart>resources/branding/strem4kodi-fanart-v2.png</fanart>
      <screenshot>resources/previews/home.jpg</screenshot>
      <screenshot>resources/previews/episodes.jpg</screenshot>
      <screenshot>resources/previews/streams.jpg</screenshot>
      <screenshot>resources/previews/addons.jpg</screenshot>
    </assets>
    <news>1.0.4: fresh Strem4Kodi artwork paths replace cached legacy branding.</news>
  </extension>
</addon></addons>