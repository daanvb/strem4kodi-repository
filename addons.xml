<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="script.strem4kodi" name="freeBird" version="1.8.232" provider-name="daanvb">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="skin.strem4kodi" version="0.1.42" />
    <import addon="script.module.qrcode" version="6.1.0+matrix.3" optional="true" />
    <import addon="script.module.inputstreamhelper" version="0.6.1" />
    <import addon="script.module.pycryptodome" version="3.4.3" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.subtitle.module" library="subtitle_service.py" />
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Stremio experience on Kodi</summary>
    <description lang="en_GB">freeBird brings your Stremio library to Kodi with cinematic browsing, configurable automatic playback, clear source selection, shared progress and IntroDB skip controls. Kodi handles video playback.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <website>https://daanvb.github.io/freeBird-repository/</website>
    <source>https://github.com/daanvb/freeBird-repository</source>
    <news>1.8.227: Add Channel 4, E4, More4, Film4 and 4seven with HD-only manifests and native Widevine licence handling. No Channel 4 account sign-in required. Device playback remains to be verified.</news>
    <assets>
      <icon>resources/branding/freebird-icon-v1.png</icon>
      <fanart>resources/branding/freebird-fanart-v1.png</fanart>
      <screenshot>resources/previews/home.jpg</screenshot>
      <screenshot>resources/previews/episodes.jpg</screenshot>
      <screenshot>resources/previews/streams.jpg</screenshot>
      <screenshot>resources/previews/addons.jpg</screenshot>
    </assets>
  </extension>
</addon><addon id="repository.strem4kodi" name="freeBird Repository" version="1.0.5" provider-name="daanvb">
  <extension point="xbmc.addon.repository" name="freeBird Repository">
    <dir>
      <info compressed="false">https://daanvb.github.io/freeBird-repository/addons.xml</info>
      <checksum verify="sha256">https://daanvb.github.io/freeBird-repository/addons.xml.sha256</checksum>
      <datadir zip="true">https://daanvb.github.io/freeBird-repository/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install and update freeBird</summary>
    <description lang="en_GB">Independent freeBird addon repository maintained by daanvb.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <website>https://daanvb.github.io/freeBird-repository/</website>
    <source>https://github.com/daanvb/freeBird-repository</source>
    <assets>
      <icon>resources/branding/freebird-icon-v1.png</icon>
      <fanart>resources/branding/freebird-fanart-v1.png</fanart>
      <screenshot>resources/previews/home.jpg</screenshot>
      <screenshot>resources/previews/episodes.jpg</screenshot>
      <screenshot>resources/previews/streams.jpg</screenshot>
      <screenshot>resources/previews/addons.jpg</screenshot>
    </assets>
    <news>1.0.5: freeBird branding and the renamed public update feed.</news>
  </extension>
