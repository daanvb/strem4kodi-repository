<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="script.strem4kodi" name="Strem4Kodi" version="1.8.32" provider-name="daanvb">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="skin.strem4kodi" version="0.1.13" />
    <import addon="script.module.qrcode" version="6.1.0+matrix.3" optional="true" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.subtitle.module" library="subtitle_service.py" />
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Stremio experience on Kodi</summary>
    <description lang="en_GB">Strem4Kodi brings your Stremio library to Kodi with cinematic browsing, configurable automatic playback, clear source selection, shared progress and IntroDB skip controls. Kodi handles video playback.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <website>https://daanvb.github.io/strem4kodi-repository/</website>
    <source>https://github.com/daanvb/strem4kodi-repository</source>
    <news>1.8.32: Smaller transparent format logos at the lower right above title rows, availability checks before playback, softer player overlays and offline English chapter labels. Includes Player skin 0.1.13. Restart Kodi after updating.</news>
    <assets>
      <icon>resources/branding/strem4kodi-icon-v2.png</icon>
      <fanart>resources/branding/strem4kodi-fanart-v2.png</fanart>
      <screenshot>resources/previews/home.jpg</screenshot>
      <screenshot>resources/previews/episodes.jpg</screenshot>
      <screenshot>resources/previews/streams.jpg</screenshot>
      <screenshot>resources/previews/addons.jpg</screenshot>
    </assets>
  </extension>
</addon><addon id="repository.strem4kodi" name="Strem4Kodi Repository" version="1.0.4" provider-name="daanvb">
  <extension point="xbmc.addon.repository" name="Strem4Kodi Repository">
    <dir>
      <info compressed="false">https://daanvb.github.io/strem4kodi-repository/addons.xml</info>
      <checksum verify="sha256">https://daanvb.github.io/strem4kodi-repository/addons.xml.sha256</checksum>
      <datadir zip="true">https://daanvb.github.io/strem4kodi-repository/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install and update Strem4Kodi</summary>
    <description lang="en_GB">Independent Strem4Kodi addon repository maintained by daanvb.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <website>https://daanvb.github.io/strem4kodi-repository/</website>
    <source>https://github.com/daanvb/strem4kodi-repository</source>
    <assets>
      <icon>resources/branding/strem4kodi-icon-v2.png</icon>
      <fanart>resources/branding/strem4kodi-fanart-v2.png</fanart>
      <screenshot>resources/previews/home.jpg</screenshot>
      <screenshot>resources/previews/episodes.jpg</screenshot>
      <screenshot>resources/previews/streams.jpg</screenshot>
      <screenshot>resources/previews/addons.jpg</screenshot>
    </assets>
    <news>1.0.4: fresh Strem4Kodi artwork paths replace cached legacy branding.</news>
  </extension>
</addon><addon id="skin.strem4kodi" name="Strem4Kodi Player" version="0.1.13" provider-name="daanvb">
  <requires>
    <import addon="xbmc.gui" version="5.17.0" />
  </requires>
  <extension point="xbmc.gui.skin" debugging="false">
    <res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
    <res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
    <res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
    <res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
    <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
    <res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
    <res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
    <res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-2.0-only, CC-BY-SA-4.0</license>
    <summary lang="en_GB">Strem4Kodi playback controls with Kodi settings available</summary>
    <description lang="en_GB">Companion skin installed alongside Strem4Kodi, with a clean playback bar and readable active audio tracks. Choose this skin in Kodi’s interface settings to activate it. Other screens retain Kodi’s Estuary layout; normal Kodi controls remain available without the app.</description>
    <source>https://github.com/daanvb/strem4kodi-repository</source>
    <assets>
      <icon>resources/strem4kodi-icon.png</icon>
      <fanart>resources/strem4kodi-fanart.png</fanart>
    </assets>
  </extension>
</addon></addons>