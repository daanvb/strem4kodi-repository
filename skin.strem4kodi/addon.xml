<?xml version='1.0' encoding='utf-8'?>
<addon id="skin.strem4kodi" name="Strem4Kodi Player" version="0.1.4" provider-name="daanvb">
  <requires>
    <import addon="xbmc.gui" version="5.17.0" />
  </requires>
  <extension point="xbmc.gui.skin" debugging="false">
    <res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
    <res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
    <res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
    <res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
    <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
    <res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
    <res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
    <res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-2.0-only, CC-BY-SA-4.0</license>
    <summary lang="en_GB">Strem4Kodi playback controls with Kodi settings available</summary>
    <description lang="en_GB">Companion skin installed alongside Strem4Kodi, with a clean playback bar and readable active audio tracks. Choose this skin in Kodi’s interface settings to activate it. Other screens retain Kodi’s Estuary layout; normal Kodi controls remain available without the app.</description>
    <source>https://github.com/daanvb/strem4kodi-repository</source>
    <assets>
      <icon>resources/strem4kodi-icon.png</icon>
      <fanart>resources/strem4kodi-fanart.png</fanart>
    </assets>
  </extension>
</addon>
